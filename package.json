{
  "name": "roblox-the-hollow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/prepare.ts && next dev",
    "build": "node --import tsx scripts/prepare.ts && next build --webpack",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts automation/tests/*.test.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "seo": "node --import tsx scripts/seo.ts",
    "check": "npm run validate && npm run typecheck && npm run lint && npm test && npm run build && npm run seo",
    "monitor": "node --import tsx automation/monitor.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
